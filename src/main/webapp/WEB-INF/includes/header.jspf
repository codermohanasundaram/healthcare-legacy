<%@ page import="com.healthcare.model.User" %>
<%
    // NOTE: pages that include this file must declare "pageTitle" before the include
    User _user = (User) session.getAttribute("user");
    String _role = (String) session.getAttribute("role");
    String _flash = (String) session.getAttribute("message");
    if (_flash != null) {
        session.removeAttribute("message");
    }
%>
<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN" "http://www.w3.org/TR/html4/loose.dtd">
<html>
<head>
<meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
<title><%= application.getInitParameter("hospitalName") %> - <%= pageTitle %></title>
<link rel="stylesheet" type="text/css" href="<%= request.getContextPath() %>/css/style.css">
<script type="text/javascript">
    function confirmDelete() {
        return confirm('Are you sure you want to delete this record?');
    }
</script>
</head>
<body>
<div id="header">
    <span class="logo"><%= application.getInitParameter("hospitalName") %></span>
    <span class="subtitle">Patient Management System</span>
    <span class="userinfo">
        Logged in as <b><%= _user != null ? _user.getFullName() : "" %></b> (<%= _role %>)
        | <a href="logout">Logout</a>
    </span>
</div>
<div id="nav">
    <a href="home.jsp">Home</a>
    <a href="patient?action=list">Patients</a>
    <a href="patient?action=new">Register Patient</a>
    <a href="doctor?action=list">Doctors</a>
    <a href="appointment?action=list">Appointments</a>
    <a href="appointment?action=new">Book Appointment</a>
    <% if ("ADMIN".equals(_role) || "BILLING".equals(_role)) { %>
    <a href="billing?action=list">Billing</a>
    <% } %>
    <% if ("ADMIN".equals(_role)) { %>
    <a href="report">Reports</a>
    <% } %>
</div>
<div id="content">
<% if (_flash != null) { %>
    <div class="message"><%= _flash %></div>
<% } %>
<% if (request.getAttribute("error") != null) { %>
    <div class="error"><%= request.getAttribute("error") %></div>
<% } %>
