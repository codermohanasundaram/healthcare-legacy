<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">

    <display-name>City General Hospital - Patient Management System</display-name>

    <!-- ============ Application settings ============ -->
    <context-param>
        <param-name>hospitalName</param-name>
        <param-value>City General Hospital</param-value>
    </context-param>
    <context-param>
        <param-name>hospitalAddress</param-name>
        <param-value>100 Main Street, Springfield</param-value>
    </context-param>
    <context-param>
        <param-name>appVersion</param-name>
        <param-value>2.2.1</param-value>
    </context-param>
    <context-param>
        <description>Tax rate shown on invoices</description>
        <param-name>taxRate</param-name>
        <param-value>18</param-value>
    </context-param>

    <!-- ============ Filters ============ -->
    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>com.healthcare.filter.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- ============ Servlets ============ -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.LoginServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>PatientServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.PatientServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>DoctorServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.DoctorServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>AppointmentServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.AppointmentServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>MedicalRecordServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.MedicalRecordServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>BillingServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.BillingServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ReportServlet</servlet-name>
        <servlet-class>com.healthcare.servlet.ReportServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>PatientServlet</servlet-name>
        <url-pattern>/patient</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>DoctorServlet</servlet-name>
        <url-pattern>/doctor</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AppointmentServlet</servlet-name>
        <url-pattern>/appointment</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>MedicalRecordServlet</servlet-name>
        <url-pattern>/medicalRecord</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>BillingServlet</servlet-name>
        <url-pattern>/billing</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ReportServlet</servlet-name>
        <url-pattern>/report</url-pattern>
    </servlet-mapping>

    <!-- ============ Session ============ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <welcome-file-list>
        <welcome-file>login.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============ Error pages ============ -->
    <error-page>
        <error-code>404</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/error.jsp</location>
    </error-page>
    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/error.jsp</location>
    </error-page>
</web-app>
